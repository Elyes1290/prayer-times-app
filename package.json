{
  "name": "prayer-times-app",
  "main": "expo-router/entry",
  "version": "1.0.26",
  "scripts": {
    "start": "expo start",
    "start:no-reload": "EXPO_NO_HOT_RELOAD=1 expo start --no-dev --minify",
    "start:safe": "EXPO_NO_HOT_RELOAD=1 expo start --no-dev",
    "sync:android-locales": "node scripts/sync-android-locales.js",
    "android:clean": "powershell -ExecutionPolicy Bypass -File scripts/android-clean.ps1",
    "android": "npm run sync:android-locales && expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "build:android": "eas build --platform android --clear-cache",
    "build:android:optimized": "eas build --platform android --clear-cache --minify",
    "build:ios": "eas build --platform ios --clear-cache",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "bundle:analyze": "npx expo export --platform android --dump-sourcemap",
    "bundle:size": "npm run bundle:analyze && node -e \"console.log('Bundle analysis complete. Check .expo folder for source maps.')\"",
    "optimize:clean": "expo r -c && npm run android",
    "eas-build-post-install": "bash ./eas-hooks/eas-build-post-install.sh"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-community/slider": "5.0.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/drawer": "^7.3.9",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "adhan": "^4.4.3",
    "expo": "54.0.36",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-av": "~16.0.8",
    "expo-background-fetch": "~14.0.9",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-sensors": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "~15.0.11",
    "i18next": "^25.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.5.2",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1312.0",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-localize": "^3.4.1",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-modal-selector": "^2.1.2",
    "react-native-permissions": "^5.4.0",
    "react-native-purchases": "^9.6.15",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "remove-accents": "^0.5.0"
  },
  "overrides": {
    "react-native-calendars": {
      "react-native-safe-area-context": "$react-native-safe-area-context"
    }
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "enabled": true,
        "exclude": ["react-native-fs"],
        "listUnknownPackages": false
      }
    }
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "babel-jest": "^30.0.4",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~54.0.12",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "^30.0.4",
    "jest-fetch-mock": "^3.0.3",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
